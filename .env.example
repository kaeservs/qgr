# Copy to .env.local. Every value is read by the server only; nothing here is
# sent to the browser.

# Supabase. Leave both out and the dashboard runs on its sample data.
# These two are public by design: the publishable key is meant to be seen, and
# row level security decides what each signed-in teammate can read.
SUPABASE_URL=https://tcinsdexwvzpznqlcpww.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_Dcqgg0uml1v08pfRZHj2YQ_2Obac58m

# n8n: the "QGR · Run pipeline" webhook and its shared secret. Without both,
# runs cannot start (the dashboard says so). The secret is a long random value
# that also goes in n8n's "QGR webhook secret" credential (Header Auth, header
# name X-QGR-Secret). Keep it out of the repository.
N8N_RUN_WEBHOOK_URL=https://n8n.tesserafy.com/webhook/qgr-run
N8N_RUN_WEBHOOK_SECRET=

# The publisher's "Post now" webhook ("QGR · Publisher"), with the same secret.
# Optional: by default it is the run webhook's address with qgr-publish in
# place of qgr-run. If n8n can't be reached, a post sent now still goes, at the
# publisher's next minute.
# N8N_PUBLISH_WEBHOOK_URL=https://n8n.tesserafy.com/webhook/qgr-publish

# The pictures' "Make now" webhook ("QGR · Pictures"), with the same secret.
# Optional, found the same way with qgr-picture. If n8n can't be reached, a
# picture asked for in the studio is made within five minutes instead.
# N8N_PICTURES_WEBHOOK_URL=https://n8n.tesserafy.com/webhook/qgr-picture

# The leads' "Read now" webhook ("QGR · Leads"), with the same secret.
# Optional, found the same way with qgr-leads. If n8n can't be reached, Zoho
# is still read, and new leads judged, every fifteen minutes. The Zoho login
# lives in n8n, never here.
# N8N_LEADS_WEBHOOK_URL=https://n8n.tesserafy.com/webhook/qgr-leads

# AI video's two webhooks ("QGR · AI video"), with the same secret. Optional,
# found the same way with qgr-video and qgr-video-price. "Make now" sends a
# video asked for at once rather than within the minute; "Price" asks
# Higgsfield what a video would cost before anyone presses Generate, so
# without it the page shows no price and a real video cannot be asked for.
# The Higgsfield login lives in n8n, never here.
# N8N_VIDEO_WEBHOOK_URL=https://n8n.tesserafy.com/webhook/qgr-video
# N8N_VIDEO_PRICE_WEBHOOK_URL=https://n8n.tesserafy.com/webhook/qgr-video-price

# The pictures' "Price" webhook ("QGR · Pictures"), with the same secret.
# Optional, found the same way with qgr-picture-price: what one Higgsfield
# picture costs, shown in Settings and the studio before any is made.
# N8N_PICTURE_PRICE_WEBHOOK_URL=https://n8n.tesserafy.com/webhook/qgr-picture-price

# What is said in an uploaded clip needs no key: Whisper hears it in the
# browser, on the team's own computer (lib/speech.ts). Pictures need none here
# either: the image model is chosen in Settings and its token is in n8n.
